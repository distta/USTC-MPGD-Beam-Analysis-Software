{
  "scripts": [
    {
      "name": "Track Analysis",
      "type": "TrackAnalysis",
      "enabled": true,
      "config": {
        "saveValidationData": true,
        "performanceHistograms": true,
        "residualHistogramRange": 2.0,
        "progressInterval": 10000
      }
    },
    {
      "name": "DUT Analysis",
      "type": "DUTAnalysis",
      "enabled": true,
      "config": {
        "runAlignment": true,
        "saveNoiseData": true,
        "saveEfficiencyMap": true,
        "efficiencyMap": {
          "xMin": 10.0,
          "xMax": 90.0,
          "xBins": 8,
          "yMin": 10.0,
          "yMax": 45.0,
          "yBins": 7,
          "matchRadius": 2.0,
          "minEntriesPerBin": 1,
          "excludeXBins": [],
          "excludeYBins": []
        },
        "progressInterval": 1000,
        "maxEvents": -1
      }
    },
    {
      "name": "Example Script",
      "type": "ExampleScript",
      "enabled": false,
      "config": {
        "message": "Hello from ExampleScript!",
        "eventLimit": 100
      }
    },
    {
      "name": "Time Resolution Analysis",
      "type": "TimeResolution",
      "enabled": false,
      "config": {
        "csvDirectory": "/path/to/lecroy/csv",
        "triggerThreshold": 1.0,
        "eventThreshold": 0.5,
        "eventBits": 16,
        "timingCacheFile": "OscilloscopeTimingCache.root",
        "rebuildTimingCache": false,
        "histogramBins": 160,
        "maxWaveformFiles": -1
      }
    },
    {
      "name": "Channel Noise Analysis",
      "type": "ChannelNoiseScript",
      "enabled": false,
      "config": {
        "maxEvents": 0,
        "progressInterval": 1000,
        "noisyThreshold": 10.0,
        "deadThreshold": 1.0
      }
    }
  ]
}
